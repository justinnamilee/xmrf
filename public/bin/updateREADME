#!/usr/bin/env bash

set -e

pod2man bin/xmrf > testing/xmrf.man

cp public/doc/README.header.md README.md
chmod 644 README.md
pod2markdown bin/xmrf | sed -E 's/^(#{1,5}) /\1# /' >> README.md
cat public/doc/README.footer.md >> README.md

[ -z "$1" ] || exit 0

git diff --quiet README.md || git commit README.md -m 'doc: regenerate `README.md`'
