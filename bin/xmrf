#!/usr/bin/perl

use strict;

 #! map has no env available

my %config =
( #? hardcoded defaults -> env -> getopts (wins)
  automatic => boolify($ENV{XMRF_AUTOMATIC} // 1),
  copy      => boolify($ENV{XMRF_COPY}      // 0),
  execute   => boolify($ENV{XMRF_EXCUTE}    // 0),
  input     =>         $ENV{XMRF_INPUT}     // q[.],
  output    =>         $ENV{XMRF_OUTPUT}    // q[.],
  recursive => boolify($ENV{XMRF_RECURSIVE} // 0),
  simple    => boolify($ENV{XMRF_SIMPLE}    // 1),
  verbose   => boolify($ENV{XMRF_VERBOSE}   // 0),
  #? positional arguments (required)
  format    => undef,
  match     => undef,
  #? special config items
  map       => {},
  name      => File::Basename::basename($0),
);

my %input =
( #? note, map is special, very special
  q[automatic|a!] => \$config{automatic},
  q[copy|c!]      => \$config{copy},
  q[execute|e!]   => \$config{execute},
  q[input|i=s]    => \$config{input},
  q[output|o=s]   => \$config{output},
  q[recursive|r!] => \$config{recursive},
  q[simple|s!]    => \$config{simple},
  q[verbose|v!]   => \$config{verbose}
);


# int main(void)

configure(%option, %config)


# subroutines

sub boolify(_)
{
  !!shift
}

sub configure(\%\%)
{

}