#!/usr/bin/perl

use strict;

use File::Copy     qw[];
use File::Spec     qw[];
use Getopt::Long   qw[];
use Pod::Usage     qw[];


# subroutine definitions

sub boolify(_);
sub configure(\%\%);
sub deconstruct(_);
sub error($;@);
sub scan(_);


# globals

my %config =
( #? hardcoded defaults -> env -> getopts (wins)
  build     => $ENV{XMRF_BUILD}     // 0,
  copy      => $ENV{XMRF_COPY}      // 0,
  execute   => $ENV{XMRF_EXCUTE}    // 0,
  full      => $ENV{XMRF_FULL}      // 0,
  input     => $ENV{XMRF_INPUT}     // q[.],
  named     => $ENV{XMRF_NAMED}     // 0,
  output    => $ENV{XMRF_OUTPUT}    // q[],
  recursive => $ENV{XMRF_RECURSIVE} // 0,
  suffix    => $ENV{XMRF_SUFFIX}    // q[^(.+)\.(.+?)$],
  verbose   => $ENV{XMRF_VERBOSE}   // 0,
  #? positional arguments (required)
  format    => undef,
  match     => undef,
  #? special config items
  help      => 0,
  map       => {}
);

my %option =
( #? note, map is special, very special
  q[build|b!]     => \$config{build},
  q[copy|c!]      => \$config{copy},
  q[execute|e!]   => \$config{execute},
  q[full|f!]      => \$config{full},
  q[help|h+]      => \$config{help},
  q[input|i=s]    => \$config{input},
  q[named|n!]     => \$config{named},
  q[output|o=s]   => \$config{output},
  q[recursive|r!] => \$config{recursive},
  q[suffix|s=s]   => \$config{suffix},
  q[verbose|v!]   => \$config{verbose}
);


# int main(void)

configure(%option, %config);

use Data::Dump qw[dd]; #!DEBUG
my @file = map { deconstruct } scan($config{input});
dd(q[config], \%config); #!DEBUG
dd(q[data], \@file); #!DEBUG


# subroutines

sub boolify(_)
{
  shift ? 1 : 0
}

sub configure(\%\%)
{
  my ($option, $config, %map) = @_;

  Getopt::Long::Configure(qw[bundling ignorecase_always]);

  Getopt::Long::GetOptions(%{$option}, q[map|m=s] => \%map)
    or Pod::Usage::pod2usage(2);

  Pod::Usage::pod2usage(-exitval => 0, -verbose => 2, -noperldoc => 1)
    if $config->{help} > 1;

  Pod::Usage::pod2usage(1)
    if $config->{help} == 1;

  error(q[Input folder must exist], qq['$config->{input}'])
    unless (-d $config->{input});

  error(q[Incorrect number of positional arguments], int(@ARGV))
    unless (@ARGV == 2);

  my ($regex, $sprintf) = @ARGV;

  $config->{match} = eval qq[qr/$regex/];

  error(q[Invalid match regex given], $@)
    if ($@);

  error(q[Sprintf should be non-zero length])
    unless (length($sprintf));

  $config->{format} = $sprintf;

  $config->{$_} = boolify($config->{$_})
    for (qw[build copy execute full named recursive verbose]);

  foreach my $m (keys(%map))
  {
    my $sub = eval qq[sub { $map{$m} }];

    error(q[Can't compile given map], $m, $@)
      if ($@);

    error(q[Given map isn't a subroutine], $m, ref($sub) // q[SCALAR])
      unless (ref($sub) eq q[CODE]);

    $config->{map}->{$m} = $sub;
  }

  $config->{suffix} = eval qq[qr/$config->{suffix}/];

  error(q[Invalid suffix regex given], $@)
    if ($@);

  $config->{verbose} = 1
    unless ($config->{execute});
}

sub deconstruct(_)
{
  my ($path, $e) = @_;
  my ($v, $d, $f) = File::Spec->splitpath($path);

  if ($f =~ s/$config{suffix}/$1/)
  {
    $e = $2;
  }

  return ({file => $f, path => $d, ext => $e // q[]});
}

sub error($;@)
{
  my ($msg, @extra) = @_;

  print STDERR join(q[: ], q[Error], $msg, @extra) . qq[\n];
  Pod::Usage::pod2usage(2);
}

sub scan(_) #? who needs file::find
{
  my ($path, @f) = @_;

  if (-f $path)
  {
    push(@f, $path);
  }
  elsif (-d $path)
  {
    if (opendir(my $dh, $path))
    {
      foreach my $i (grep { !/^\.\.?$/ } readdir($dh))
      {
        my $p = File::Spec->join($path, $i);

        push(@f, -f $p ? $p : (-d $p && $config{recurse} ? scan($p) : ()));
      }
    }
    else
    {
      warn qq[Unable to open directory: '$path': $!\n];
    }
  }

  return (@f);
}


__END__

=head1 NAME

xmrf - Regex-map Rename File

=head1 SYNOPSIS

xmrf [options] regex sprintf

 Options:
   --build     | -b          create output directory structure as-needed
   --copy      | -c          copy instead of rename, very useful
   --execute   | -e          actually perform the operation, safety measure
   --full      | -f          pass full path to regex, not just filename
   --help      | -h          show the full help dialog
   --input     | -i <dir>    scan <dir> for files (or subdirs too with -r)
   --map       | -m <k>=<v>  defines a suboutine <v> to run against <k> (fun)
   --named     | -n          use named capture groups instead of numeric
   --output    | -o <dir>    put files in <dir>
   --recursive | -r          scan subfolders of the input dir too
   --suffix    | -s <str>    override the default suffix extraction regex
   --verbose   | -v          show more information, defaults on without execute

=head1 OPTIONS

=over 4

=item B<--build>

After the full output path is generated, create the directory structure as
required with B<File::Path::make_path>.  If not set or B<--no-build> is set
then an error will be thrown if the output path doesn't exist already for the
file to be copied to.

=item B<--copy>

Use B<File::Copy::copy> instead of B<File::Copy::move> as the operation on the
input file and output file.

=item B<--execute>

Without specifying B<--execute> only the planned operation will be shown.

=item B<--full>

In B<--no-full> mode (default) only the filename (without any file extension)
will be passed to the regex.  When the job is complete the output file will be
prepended with the selected output folder (defaults to nothing) and the
extension will be re-attached.

If enabled with B<--full>, then the entire path for the file and its extension
will be passed to your regex (sometimes quite useful).

=item B<--input> C<dir>

Change the folder to scan from C<./> to C<dir>.

=item B<--map> C<key=val>

Each C<key> is either a numeric or named captured group, and each C<val> will
be compiled as a subroutine that is given the data returned by the capture
group.  The subroutine should further process the capture group's value and
ultimately return what the sprintf format is expecting for that slot.

If the B<--named> flag is specified then your C<key>s should match the named
capture groups, otherwise they should be numeric.

Multiple B<--map> flags can be included to specify more mapping subroutines.

=item B<--named>

In B<--no-named> mode (default) the regex capture groups are taken in order as
an array.  If B<--named> is specified then it is expected the regex will use
named capture groups.  These named capture groups will be sorted with Perl'`s
C<sort> function when applied to the B<sprintf> section.

=item B<--output> C<dir>

The output folder is a bit different to the input folder.  If unspecified it
will default to the input folder.  However, if B<--no-automatic> is set, then
this defaulting to input folder will not occur.

In either mode, it will get prepended to the output file, however it is an
empty string by default.  This means when in B<--no-automatic> mode, the output
path could also be specified as part of the B<sprintf> section, if desired.

=item B<--recursive>

If set the input folder and all its subfolders will be scanned for files.

=item B<--suffix> C<str>

The default suffix extraction regex is lazy, taking only the shortest possible
value, i.e. C<item.tar.gz> produces C<gz> as the suffix.  Supply a new regex
with the C<str> provided.

=item B<--verbose>

Behaves much like C<cp> or C<mv> verbose flag.  If B<--execute> isn't specified
then it is forced on to show the planned operations.

=back

=head1 DESCRIPTION

B<XMRF> will rename (or copy) files based on an input dir, an output dir, a
regex, and an sprintf format.  It tries to use some sane defaults for things
that aren't provided.

=cut
